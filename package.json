{
  "name": "ks-vscode",
  "displayName": "Keeper Security",
  "description": "Never commit secrets to your code again - secure them in your Keeper vault",
  "version": "2.0.0",
  "license": "MIT",
  "publisher": "KeeperSecurityDev",
  "galleryBanner": {
    "color": "#1a365d",
    "theme": "dark"
  },
  "icon": "assets/keeper_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keeper-Security/keeper-vscode-extension"
  },
  "homepage": "https://docs.keeper.io/en/keeperpam/secrets-manager/integrations/vs-code-extension",
  "bugs": {
    "url": "https://github.com/Keeper-Security/keeper-vscode-extension/issues"
  },
  "keywords": [
    "keeper",
    "security",
    "password",
    "secrets",
    "dotenv"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ks-vscode.saveValueToVault",
        "title": "Save in Keeper Security",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.getValueFromVault",
        "title": "Get from Keeper Security",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.generatePassword",
        "title": "Generate Password",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.runSecurely",
        "title": "Run Securely",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.chooseFolder",
        "title": "Choose Folder",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.openLogs",
        "title": "Open Logs",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.switchToCli",
        "title": "Switch to CLI",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.switchToKsm",
        "title": "Switch to KSM",
        "category": "Keeper Security"
      },
      {
        "command": "ks-vscode.authenticate",
        "title": "Authenticate",
        "category": "Keeper Security"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ks-vscode.openLogs",
          "when": "config.keeper-security.mode.type === 'cli' || config.keeper-security.mode.type === 'ksm'"
        },
        {
          "command": "ks-vscode.switchToCli",
          "when": "config.keeper-security.mode.type === 'ksm'"
        },
        {
          "command": "ks-vscode.switchToKsm",
          "when": "config.keeper-security.mode.type === 'cli'"
        },
        {
          "command": "ks-vscode.authenticate",
          "when": "config.keeper-security.mode.type === 'ksm'"
        }
      ]
    },
    "configuration": [
      {
        "type": "object",
        "title": "Keeper Security",
        "id": "keeper-security",
        "properties": {
          "keeper-security.mode.type": {
            "order": 0,
            "type": "string",
            "default": "cli",
            "description": "Mode type to use for Keeper Security. ( Reload required )",
            "enum": [
              "cli",
              "ksm"
            ],
            "enumDescriptions": [
              "Uses the Keeper commander CLI.",
              "Uses the Keeper Secrets Manager."
            ]
          },
          "keeper-security.debug.enabled": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "description": "Log debugger data. ( Reload required )"
          },
          "keeper-security.editor.secretDetection": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "description": "Suggest storing a value when it looks like a secret."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "webpack": "webpack --mode production --devtool hidden-source-map",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "pre-commit": "npm run lint && npm run test",
    "clean": "rm -rf dist out coverage",
    "vscode:prepublish": "npm run webpack",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.25.1",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@keeper-security/secrets-manager-core": "^17.2.0",
    "dotenv": "^17.2.0"
  }
}
